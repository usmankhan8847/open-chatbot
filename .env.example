# BotForge - Environment Configuration
# ======================================
# Copy this file to .env and update the values for your setup

# --- Application ---
APP_NAME="OpenChatbot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Locale settings
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Database ---
# Options: mysql, sqlite, pgsql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=botforge
DB_USERNAME=root
DB_PASSWORD=

# For SQLite (uncomment below and set DB_CONNECTION=sqlite)
# DB_DATABASE=/absolute/path/to/database.sqlite

# --- Session & Queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# --- Cache ---
CACHE_STORE=database

# --- AI Provider Configuration ---
# ===============================
# Choose your AI provider below and configure accordingly
#
# Supported providers: openai, anthropic, gemini, openrouter, custom
#
# --- OpenAI Configuration ---
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-openai-key-here
# AI_MODEL=gpt-4o
# AI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Claude) Configuration ---
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-api03-your-anthropic-key-here
# AI_MODEL=claude-sonnet-4-20250514
# AI_BASE_URL=https://api.anthropic.com/v1

# --- Google Gemini Configuration ---
# AI_PROVIDER=gemini
# AI_API_KEY=your-gemini-api-key-here
# AI_MODEL=gemini-2.0-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenRouter (Unified API for multiple models) ---
# AI_PROVIDER=openrouter
# AI_API_KEY=your-openrouter-key-here
# AI_MODEL=openai/gpt-4o
# AI_BASE_URL=https://openrouter.ai/api/v1

# --- Custom / Self-hosted Models ---
# AI_PROVIDER=custom
# AI_API_KEY=your-api-key
# AI_MODEL=your-model-name
# AI_BASE_URL=https://your-custom-endpoint.com/v1

# --- Security (Sanctum SPA Auth) ---
# List your frontend domains (comma-separated)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

# --- Vite Frontend Config ---
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="${APP_URL}/api"

# --- Optional: Email (for password resets, etc.) ---
# MAIL_MAILER=log
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

# --- Optional: Redis (for caching/queue) ---
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379